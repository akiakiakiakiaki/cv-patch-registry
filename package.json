{
  "name": "cv-patch-registry",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:set-role": "node --env-file=.env.development.local scripts/set-user-role.mjs",
    "db:set-role:prod": "node --env-file=.env.production.local scripts/set-user-role.mjs",
    "storage:migrate-local": "node --env-file=.env.development.local scripts/migrate-local-uploads-to-supabase.mjs",
    "proton:clone": "node --env-file=.env.development.local node_modules/.bin/tsx --tsconfig tsconfig.json scripts/clone-proton.mts",
    "tags:capitalize": "node --env-file=.env.development.local node_modules/.bin/tsx --tsconfig tsconfig.json scripts/capitalize-tag-labels.mts",
    "backup:export": "node --env-file=.env.development.local node_modules/.bin/tsx --tsconfig tsconfig.json scripts/backup-export.mts",
    "backup:export:prod": "node --env-file=.env.production.local node_modules/.bin/tsx --tsconfig tsconfig.json scripts/backup-export.mts",
    "backup:restore": "node --env-file=.env.development.local node_modules/.bin/tsx --tsconfig tsconfig.json scripts/backup-restore.mts",
    "backup:restore:prod": "node --env-file=.env.production.local node_modules/.bin/tsx --tsconfig tsconfig.json scripts/backup-restore.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "fflate": "0.8.3",
    "isomorphic-dompurify": "^4.5.0",
    "next": "16.3.6",
    "pg": "^8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "22.13.10",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.1",
    "sass": "^1.105.0",
    "typescript": "5.8.2",
    "vitest": "^4.1.11"
  }
}
