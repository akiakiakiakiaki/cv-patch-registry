# Dependencies and generated application output
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo

# Local environment files; keep the template tracked
.env.*
!.env.example

# Test and coverage artifacts
coverage/
.vitest/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Logs and operating system files
*.log
.DS_Store

# Runtime uploads, local database and backups (never commit: they hold every account)
backups/
public/assets/uploads/
.data/

# Generated by Next.js on every dev/build run (points to dev or build types); not tracked
next-env.d.ts
