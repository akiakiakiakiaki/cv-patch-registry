# Patch Sheet — Environment Configuration

# Authentication
# Generate a private random secret for deployed environments. Never use a NEXT_PUBLIC_ prefix.
BETTER_AUTH_SECRET=
# Local default. Set the canonical app URL in Vercel Production; Preview uses VERCEL_URL automatically.
BETTER_AUTH_URL=http://localhost:3000
# Accepted values: true | false. Keep the NEXT_PUBLIC_ flag in sync with the server flag.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
NEXT_PUBLIC_AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Mail (verification, password reset, approval notices). Accepted providers: console | brevo.
# console prints mails to the server log and is the default outside production; production needs a real provider.
MAIL_PROVIDER=console
# Sender on a domain the mail service has verified, e.g. noreply@example.com.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=CV Patch Registry
# Server-only key for MAIL_PROVIDER=brevo. Never use a NEXT_PUBLIC_ prefix or commit its value.
BREVO_API_KEY=

# Development tools
# Accepted values: true | false. Layout debugging is available only in development.
NEXT_PUBLIC_DEBUG_LAYOUT=false

# Legacy synths
# Accepted values: true | false. false hides the built-in legacy Behringer Proton and its patches;
# their data stays in the database. Unlike FEATURE_AUDIO, any other value or none keeps them visible,
# so nothing disappears in an environment without this setting.
FEATURE_LEGACY_SYNTHS=true

# Optional audio samples
# Accepted values: true | false. Keep the client and server flags in sync.
FEATURE_AUDIO=false
NEXT_PUBLIC_FEATURE_AUDIO=false

# Database
# Accepted values: pglite | postgres. PGlite is local-only; Vercel requires postgres.
PATCH_DB_PROVIDER=pglite
# PGlite only; defaults to .data/pglite.
PATCH_DB_DIR=.data/pglite
# Required for postgres. Use a postgresql:// or postgres:// connection URL.
# For Vercel with Supabase, use the transaction pooler connection string.
DATABASE_URL=
# Positive integer; maximum PostgreSQL connections per app process.
PATCH_DB_POOL_MAX=1

# Uploaded files
# Accepted values: local | supabase. Local is the default; Vercel requires supabase.
STORAGE_PROVIDER=local
# Required for Supabase Storage; format: https://<project-ref>.supabase.co
SUPABASE_URL=
# Must name an existing bucket. The app returns direct public URLs, so this bucket must be public.
SUPABASE_STORAGE_BUCKET=patch-assets
# Server-only key. Prefer a current sb_secret_... key. Never use NEXT_PUBLIC_ or commit its value.
SUPABASE_SECRET_KEY=
# Legacy alternative, accepted if SUPABASE_SECRET_KEY is unset: SUPABASE_SERVICE_ROLE_KEY=<service_role JWT>
